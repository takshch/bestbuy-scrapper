# --- PostgreSQL (docker compose up -d) ---
POSTGRES_USER=scraper
POSTGRES_PASSWORD=scraper
POSTGRES_DB=bestbuy
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=3000
# Used when running the API outside Docker; docker compose overrides it to use the
# "postgres" service host. Plain postgresql:// is converted to the asyncpg driver.
DATABASE_URL=postgresql://scraper:scraper@localhost:5432/bestbuy

# Run Chromium headless (set false to watch the browser while debugging)
SCRAPER_HEADLESS=true

# --- Workers / queue ---
# Browsers per worker process (each scrapes one page at a time). Scale out with more workers.
WORKER_CONCURRENCY=2
# Running tasks whose heartbeat is older than this are requeued (worker crash recovery)
TASK_LEASE_SECONDS=120
# Attempts per page before it is marked failed
TASK_MAX_ATTEMPTS=2
# Random delay (s) before each page request, to avoid hitting the site in lockstep
REQUEST_JITTER_MIN=1
REQUEST_JITTER_MAX=3
# Max seconds to wait for a page's lazily loaded product data
PAGE_LOAD_BUDGET=25
# Optional: path to a CloakBrowser binary (auto-downloaded to ~/.cloakbrowser if unset)
# CHROME_BINARY=
# Browser timezone/locale; keep consistent with the proxy exit location
BROWSER_TIMEZONE=America/New_York
BROWSER_LOCALE=en-US

# --- Oxylabs proxy (US exit IPs) ---
# fallback = scrape from the server's own IP; switch to Oxylabs only if that fails
# always   = always use Oxylabs;  never = never use Oxylabs
PROXY_MODE=fallback
# After a fallback, route new jobs straight to Oxylabs for this many seconds (0 = off)
DIRECT_RETRY_AFTER=1800
OXYLABS_USERNAME=your_oxylabs_username
OXYLABS_PASSWORD=your_oxylabs_password
# residential -> pr.oxylabs.io:7777 | datacenter -> dc.oxylabs.io:8000
OXYLABS_PROXY_TYPE=residential
OXYLABS_COUNTRY=US
# Optional residential state targeting to match BROWSER_TIMEZONE, e.g. us_new_york
OXYLABS_STATE=us_new_york
